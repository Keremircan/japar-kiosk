# Kiosk ortam değişkenleri. Bu dosyayı .env.local olarak kopyalayıp doldurun;
# Vercel için aynı değişkenleri Project Settings > Environment Variables altına girin.

# Terminal kilit şifresi: 4-12 haneli sayı. Tanımlı değilse canlıda kilit açılamaz
# (yerel geliştirmede 1234 kullanılır). Değiştirildiğinde açık terminaller kilitlenir.
KIOSK_ACCESS_PIN=

# Karekod sırları: PWA (JaparQrNext) sunucusundakilerle BİREBİR aynı olmalı.
SHARED_SECRET_BASE32=
AES_SECRET_KEY=

# Ekranda ve karekod içinde görünen fabrika / kapı kimliği (en fazla 50 karakter)
FACTORY_ID=JaparFAB-01
GATE_ID=Gate-01
